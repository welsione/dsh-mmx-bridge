{
  "name": "dsh-mmx-bridge",
  "private": false,
  "version": "1.0.2",
  "description": "MiniMax multimodal bridge for DeepSeek Harness (DSH). One mmx_bridge tool covers describe/image/video/speech/music/cover/search/quota; optional web_search/read_image takeover; built-in client enhancement renders inline players/previews in the Web GUI.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepublishOnly": "npm run check"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welsione/dsh-mmx-bridge.git"
  },
  "homepage": "https://github.com/welsione/dsh-mmx-bridge",
  "bugs": {
    "url": "https://github.com/welsione/dsh-mmx-bridge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "minimax",
    "mmx-cli",
    "multimodal",
    "plugin",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18"
  }
}
