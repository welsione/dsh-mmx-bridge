{
  "name": "dsh-mmx-bridge",
  "private": false,
  "version": "1.0.8",
  "description": "MiniMax multimodal bridge for DeepSeek Harness (DSH). One mmx_bridge tool covers describe/image/video/speech/music/cover/search/quota; optional web_search/read_image takeover; built-in client enhancement renders inline players/previews plus a settings-page management card in the Web GUI.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/img-cache.js && node --check lib/imgjson.mjs",
    "test": "node test/img-cache.test.mjs && node test/readimage-wrapper.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welsione/dsh-mmx-bridge.git"
  },
  "homepage": "https://github.com/welsione/dsh-mmx-bridge",
  "bugs": {
    "url": "https://github.com/welsione/dsh-mmx-bridge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "minimax",
    "mmx-cli",
    "multimodal",
    "plugin",
    "ai-agent",
    "imgjson",
    "image-cache"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=18"
  }
}
